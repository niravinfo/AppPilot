<UserControl x:Class="AppPilot.Controls.SvgIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Path x:Name="IconPath"
          Data="{Binding IconData, ElementName=Root}"
          Fill="{Binding IconFill, ElementName=Root}"
          Width="{Binding IconSize, ElementName=Root}"
          Height="{Binding IconSize, ElementName=Root}"
          Stretch="Uniform"
          RenderTransformOrigin="0.5,0.5">
        <Path.RenderTransform>
            <ScaleTransform ScaleX="{Binding ScaleX, ElementName=Root}" 
                           ScaleY="{Binding ScaleY, ElementName=Root}"/>
        </Path.RenderTransform>
    </Path>
</UserControl>

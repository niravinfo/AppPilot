{
  "AppPilot": {
    // Optional: root directory for resolving relative paths below.
    // Supports environment variables, e.g. "%USERPROFILE%\\Projects".
    // If omitted, paths are resolved relative to the AppPilot.exe directory.
    "BasePath": "C:\\YourProjects\\Root"
  },
  "GitRepositories": [
    {
      "Name": "AppPilotExamples",
      "DisplayName": "AppPilot Examples",
      "LocalPath": "examples",
      "SolutionPath": "AppPilotExamples.slnx",
      "DefaultBranch": "main",
      "LinkedServiceNames": [
        "MyWorkerService",
        "MyGrpcApi",
        "MyWebApi"
      ]
    }
  ],
  "Groups": [
    {
      "Id": "apis_01",
      "Name": "APIs",
      "DisplayOrder": 1,
      "ColorCode": "#33FF57"
    },
    {
      "Id": "workers_01",
      "Name": "Workers",
      "DisplayOrder": 2
    }
  ],
  "Services": [
    {
      // --- Windows Service (Worker) ---
      // Installed and managed via sc.exe. Requires UseWindowsService() in the host builder
      // and the Microsoft.Extensions.Hosting.WindowsServices NuGet package.
      "Name": "MyWorkerService",
      "DisplayName": "My Worker Service",
      "Type": "Worker",
      "GroupId": "workers_01",

      // Relative to BasePath — or supply an absolute path.
      "ExecutablePath": "MyWorker\\bin\\Debug\\net10.0\\MyWorker.exe",
      "Arguments": "",
      "WorkingDirectory": "MyWorker\\bin\\Debug\\net10.0",

      "AutoStart": false,
      "DisplayOrder": 1,
      "Dependencies": [],
      "Environment": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "UseWindowsService": false
    },
    {
      // --- gRPC API process ---
      // gRPC requires HTTP/2. On .NET, HTTP/2 over cleartext (h2c) needs extra client-side
      // switches and is not the default. Use HTTPS so TLS-ALPN negotiates HTTP/2 automatically.
      // ASPNETCORE_Kestrel__Protocols=Http2 tells Kestrel to accept HTTP/2 connections only.
      // Leave HealthCheckUrl empty unless your gRPC service also exposes a plain HTTP
      // health endpoint (e.g. app.MapHealthChecks("/health")).
      "Name": "MyGrpcApi",
      "DisplayName": "My gRPC API",
      "Type": "Grpc",
      "GroupId": "apis_01",
      "ExecutablePath": "MyGrpcApi\\bin\\Debug\\net10.0\\MyGrpcApi.exe",
      "Arguments": "--urls=https://localhost:7002",
      "WorkingDirectory": "MyGrpcApi\\bin\\Debug\\net10.0",
      "Port": 7002,
      "HealthCheckUrl": "https://localhost:7002",
      "AutoStart": false,
      "DisplayOrder": 2,
      "Dependencies": [],
      "Environment": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_Kestrel__Protocols": "Http2"
      }
    },
    {
      // --- Web API process ---
      "Name": "MyWebApi",
      "DisplayName": "My Web API",
      "Type": "WebApi",
      "GroupId": "apis_01",

      // Absolute path example — use this when the project lives outside BasePath.
      "ExecutablePath": "C:\\OtherLocation\\MyWebApi\\bin\\Debug\\net10.0\\MyWebApi.exe",
      "Arguments": "--urls=http://localhost:7001",
      "WorkingDirectory": "C:\\OtherLocation\\MyWebApi\\bin\\Debug\\net10.0",
      "Port": 7001,
      "HealthCheckUrl": "http://localhost:7001/health",
      "AutoStart": false,
      "DisplayOrder": 3,
      "Dependencies": [],
      "Environment": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}

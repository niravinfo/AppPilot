<Window x:Class="AppPilot.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AppPilot.ViewModels"
        xmlns:views="clr-namespace:AppPilot.Views"
        mc:Ignorable="d"
        Title="AppPilot"
        Height="660"
        Width="960"
        MinHeight="480"
        MinWidth="720"
        Background="{DynamicResource WindowBg}"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico">

    <Window.InputBindings>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding FocusSearchCommand}"/>
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseAppCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Geometry x:Key="IconServices">
            M0 4v14a1.001 1.001 0 0 0 1 1h9v1H8v1h8v-1h-2v-1h9a1.001 1.001 0 0 0 1-1V4a1.001 1.001 0 0 0-1-1H1a1.001 1.001 0 0 0-1 1zm13 16h-2v-1h2zm10-2H1V4h22z
        </Geometry>
        <Geometry x:Key="IconGit">
            M499 228q-21 0-36 15l-73 73 92 92q17-6 34-2t29.5 16.5 16 29.5-1.5 34l88 88q17-5 34-1.5t30 16.5q18 18 18 43.5t-18 43-43.5 17.5-43.5-17q-13-14-16.5-32t3.5-35l-83-83v218q9 4 16 11 18 18 18 43.5T545 842t-43.5 18-43-18-17.5-43.5 18-43.5q8-8 20-13V522q-12-4-20-13-14-13-17.5-31.5T445 442l-90-91-240 240q-15 15-15 36.5t15 36.5l349 349q15 15 36.5 15t36.5-15l348-348q15-15 15-36.5T885 592L536 243q-15-15-37-15
        </Geometry>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource HeaderBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <!-- Branding -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,14,0"
                            Background="{DynamicResource BrandGradient}">
                        <Grid>
                            <Path Data="{StaticResource IconLightning}" 
                                  Fill="{DynamicResource DialogIconFill}"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AppPilot"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Local Service Manager"
                                   FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Search bar + Global action buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,0,0">
                    <Button Style="{StaticResource ToolbarBtn}"
                            Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}"
                                  Fill="{DynamicResource TextMuted}"
                                  Width="14" Height="14"
                                  Margin="0,0,6,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StartBtn}"
                            Command="{Binding StartAllCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlay}"
                                  Fill="{DynamicResource StartFg}"
                                  Width="12" Height="12"
                                  Margin="0,0,6,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Start All" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerBtn}"
                            Command="{Binding StopAllCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconStop}"
                                  Fill="{DynamicResource DangerFg}"
                                  Width="12" Height="12"
                                  Margin="0,0,6,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Stop All" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Separator -->
                    <Rectangle Width="1" Height="20"
                               Fill="{DynamicResource HeaderBorder}"
                               Margin="4,0,12,0"
                               VerticalAlignment="Center"/>
                    <!-- Add Service -->
                    <Button Style="{StaticResource AccentBtn}"
                            Command="{Binding AddServiceCommand}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}"
                                  Fill="{DynamicResource AccentFg}"
                                  Width="14" Height="14"
                                  Margin="0,0,5,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Add Service" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Discover Services -->
                    <Button Style="{StaticResource ToolbarBtn}"
                            Command="{Binding DiscoverServicesCommand}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSearch}"
                                  Fill="{DynamicResource TextMuted}"
                                  Width="14" Height="14"
                                  Margin="0,0,5,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Discover" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Separator -->
                    <Rectangle Width="1" Height="20"
                               Fill="{DynamicResource HeaderBorder}"
                               Margin="4,0,12,0"
                               VerticalAlignment="Center"/>
                    <!-- Manage Groups -->
                    <Button Style="{StaticResource ToolbarBtn}"
                            Command="{Binding ManageGroupsCommand}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z"
                                  Fill="{DynamicResource TextMuted}"
                                  Width="14" Height="14"
                                  Margin="0,0,5,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Groups" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Separator -->
                    <Rectangle Width="1" Height="20"
                               Fill="{DynamicResource HeaderBorder}"
                               Margin="4,0,12,0"
                               VerticalAlignment="Center"/>
                    <!-- Theme toggle -->
                    <Button Style="{StaticResource ToolbarBtn}" Margin="0"
                            Command="{Binding ToggleThemeCommand}">
                        <Path Width="20" Height="20"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Fill="{DynamicResource TextMuted}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource IconDark}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLightTheme}" Value="False">
                                            <Setter Property="Data" Value="{StaticResource IconLight}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <!-- Settings -->
                    <Button Style="{StaticResource ToolbarBtn}"
                            Command="{Binding OpenSettingsCommand}"
                            Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSettings}"
                                  Fill="{DynamicResource TextMuted}"
                                  Width="14" Height="14"
                                  Margin="0,0,5,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ Tab Navigation (Row 1) ══════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource TabNavBg}"
                BorderBrush="{DynamicResource HeaderBorder}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <!-- Services tab -->
                    <Border BorderThickness="0,0,0,1" Padding="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="0">
                                        <Setter Property="BorderBrush" Value="{DynamicResource TabActiveBorder}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Style="{StaticResource TabBtn}" Command="{Binding SelectServicesTabCommand}" Padding="10,0">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Path Data="{StaticResource IconServices}"
                                      Fill="{DynamicResource TabInactiveFg}"
                                      Width="16" Height="16"
                                      Margin="0,0,10,0"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTab}" Value="0">
                                                    <Setter Property="Fill" Value="{DynamicResource TabActiveFg}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock FontSize="15" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text"       Value="Services"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TabInactiveFg}"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTab}" Value="0">
                                                    <Setter Property="Foreground" Value="{DynamicResource TabActiveFg}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Margin="7,0,0,0" Padding="6,2" CornerRadius="10"
                                        Background="{DynamicResource TypeBadgeBg}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Services.Count}"
                                               FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TypeBadgeFg}"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </Border>
                    <!-- Git Repos tab -->
                    <Border BorderThickness="0,0,0,1" Padding="0" Margin="6,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                                        <Setter Property="BorderBrush" Value="{DynamicResource TabActiveBorder}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Style="{StaticResource TabBtn}" Command="{Binding SelectGitTabCommand}" Padding="10,0">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Path Data="{StaticResource IconGit}"
                                      Fill="{DynamicResource TabInactiveFg}"
                                      Width="16" Height="16"
                                      Margin="0,0,10,0"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                                                    <Setter Property="Fill" Value="{DynamicResource TabActiveFg}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock FontSize="15" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text"       Value="Git Repos"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TabInactiveFg}"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                                                    <Setter Property="Foreground" Value="{DynamicResource TabActiveFg}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Margin="7,0,0,0" Padding="6,2" CornerRadius="10"
                                        Background="{DynamicResource TypeBadgeBg}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GitRepositories.Count}"
                                               FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TypeBadgeFg}"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>
                <!-- Search Bar at right end -->
                <Border Grid.Column="1" Background="{DynamicResource InputBg}"
                        BorderBrush="{DynamicResource InputBorder}"
                        BorderThickness="1" CornerRadius="8"
                        Height="32" Margin="0,0,18,0"
                        VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="10,0,2,0" IsHitTestVisible="False">
                            <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource TextMuted}" Width="13" Height="13" Stretch="Uniform"/>
                        </TextBlock>
                        <TextBox x:Name="SearchTextBox"
                                 Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimary}"
                                 CaretBrush="{DynamicResource TextPrimary}"
                                 Padding="4,8,10,8" FontSize="13"
                                 VerticalAlignment="Center"
                                 Width="220">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Tag" Value="Search Services"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                                            <Setter Property="Tag" Value="Search Git Repos"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Grid>
                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                        <TextBlock IsHitTestVisible="False"
                                                   Text="{TemplateBinding Tag}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="13"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Content: Git Repos tab -->
        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <views:GitReposTab/>
        </Grid>

        <!-- Content: Services tab -->
        <DockPanel Grid.Row="2" LastChildFill="True">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <views:ServicesTab/>
        </DockPanel>

        <!-- Status bar -->
        <Border Grid.Row="3"
                Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource HeaderBorder}"
                BorderThickness="0,1,0,0"
                Padding="20,7">
            <Grid>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource TextMuted}" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding LastUpdateTime, StringFormat='Updated: {0}'}"
                           Foreground="{DynamicResource TextMuted}" FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>

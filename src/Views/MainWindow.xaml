<Window x:Class="AppPilot.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AppPilot.ViewModels"
        mc:Ignorable="d"
        Title="AppPilot"
        Height="660"
        Width="960"
        MinHeight="480"
        MinWidth="720"
        Background="{DynamicResource WindowBg}"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Scrollbar thumb -->
        <Style x:Key="ScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{DynamicResource ScrollThumb}" CornerRadius="3" Margin="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollPageBtn" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageBtn}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageBtn}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar button -->
        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Background"     Value="{DynamicResource BtnBg}"/>
            <Setter Property="Foreground"     Value="{DynamicResource BtnFg}"/>
            <Setter Property="BorderBrush"    Value="{DynamicResource BtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"        Value="14,7"/>
            <Setter Property="Margin"         Value="0,0,8,0"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"  Value="{DynamicResource BtnHoverBg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BtnHoverBorder}"/>
                                <Setter Property="Foreground"  Value="{DynamicResource BtnHoverFg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BtnPressedBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Background"  Value="{DynamicResource AccentBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
            <Setter Property="Foreground"  Value="{DynamicResource AccentFg}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Background"  Value="{DynamicResource DangerBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
            <Setter Property="Foreground"  Value="{DynamicResource DangerFg}"/>
        </Style>

        <!-- Card icon button -->
        <Style x:Key="CardBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource CardBtnFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="30"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardBtnHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource CardBtnHoverFg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardBtnPressedBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource HeaderBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <!-- Branding -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4C8EF8" Offset="0"/>
                                <GradientStop Color="#7C50D8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="⚡" FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AppPilot"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Local Service Manager"
                                   FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Global action buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarBtn}"
                            Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↺" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentBtn}"
                            Command="{Binding StartAllCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Start All" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerBtn}"
                            Command="{Binding StopAllCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="■" FontSize="9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Stop All" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Separator -->
                    <Rectangle Width="1" Height="20"
                               Fill="{DynamicResource HeaderBorder}"
                               Margin="4,0,12,0"
                               VerticalAlignment="Center"/>
                    <!-- Theme toggle -->
                    <Button Style="{StaticResource ToolbarBtn}" Margin="0"
                            Command="{Binding ToggleThemeCommand}">
                        <TextBlock VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="☽  Dark"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLightTheme}" Value="False">
                                            <Setter Property="Text" Value="☼  Light"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Grouped service list -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,8,10,8">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4,0,8">

                            <!-- Group header (hidden when single unnamed group) -->
                            <Border Visibility="{Binding ShowHeader, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource GroupHeaderBg}"
                                    BorderBrush="{DynamicResource GroupHeaderBorder}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="8,8,0,0"
                                    Padding="14,8,10,8"
                                    Margin="0,0,0,4">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GroupName}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource GroupHeaderFg}"/>
                                        <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="8"
                                                Background="{DynamicResource TypeBadgeBg}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Items.Count}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource AccentBtn}"
                                                Padding="8,4" Margin="0,0,6,0"
                                                Command="{Binding StartGroupCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="▶" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Start" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DangerBtn}"
                                                Padding="8,4" Margin="0"
                                                Command="{Binding StopGroupCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="■" FontSize="8" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Stop" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Service cards -->
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6"
                                                CornerRadius="10"
                                                BorderThickness="1"
                                                ClipToBounds="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"  Value="{DynamicResource CardBg}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBg}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource CardErrorBorder}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <!-- Main row -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="5"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Status accent bar -->
                                                    <Border Grid.Column="0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource StatusStoppedColor}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusRunningColor}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Starting">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusTransientColor}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Stopping">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusTransientColor}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusErrorColor}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                    <!-- Service name + type chip -->
                                                    <StackPanel Grid.Column="1" Margin="14,12,10,12" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimary}"/>
                                                            <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4"
                                                                    Background="{DynamicResource TypeBadgeBg}"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding TypeName}"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource TypeBadgeFg}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Status pill -->
                                                    <Border Grid.Column="2" Margin="0,0,10,0"
                                                            Padding="10,4" CornerRadius="20"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource PillDefaultBg}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                        <Setter Property="Background" Value="{DynamicResource PillRunningBg}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Starting">
                                                                        <Setter Property="Background" Value="{DynamicResource PillTransientBg}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Stopping">
                                                                        <Setter Property="Background" Value="{DynamicResource PillTransientBg}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                        <Setter Property="Background" Value="{DynamicResource PillErrorBg}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="{DynamicResource StatusStoppedColor}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                                <Setter Property="Fill" Value="{DynamicResource StatusRunningColor}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Starting">
                                                                                <Setter Property="Fill" Value="{DynamicResource StatusTransientColor}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Stopping">
                                                                                <Setter Property="Fill" Value="{DynamicResource StatusTransientColor}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                                <Setter Property="Fill" Value="{DynamicResource StatusErrorColor}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource PillDefaultFg}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                                <Setter Property="Foreground" Value="{DynamicResource PillRunningFg}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Starting">
                                                                                <Setter Property="Foreground" Value="{DynamicResource PillTransientFg}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Stopping">
                                                                                <Setter Property="Foreground" Value="{DynamicResource PillTransientFg}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                                <Setter Property="Foreground" Value="{DynamicResource PillErrorFg}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Port -->
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding Port}"
                                                               FontSize="12"
                                                               FontFamily="Consolas"
                                                               Foreground="{DynamicResource PortFg}"
                                                               VerticalAlignment="Center"/>

                                                    <!-- Action buttons -->
                                                    <StackPanel Grid.Column="4"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,10,0">
                                                        <Button Style="{StaticResource CardBtn}"
                                                                Command="{Binding StartCommand}"
                                                                IsEnabled="{Binding CanStart}"
                                                                ToolTip="Start">
                                                            <TextBlock Text="▶" FontSize="11"/>
                                                        </Button>
                                                        <Button Style="{StaticResource CardBtn}"
                                                                Command="{Binding StopCommand}"
                                                                IsEnabled="{Binding CanStop}"
                                                                ToolTip="Stop">
                                                            <TextBlock Text="⏹" FontSize="11"/>
                                                        </Button>
                                                        <Button Style="{StaticResource CardBtn}"
                                                                Command="{Binding RestartCommand}"
                                                                IsEnabled="{Binding CanRestart}"
                                                                ToolTip="Restart">
                                                            <TextBlock Text="↺" FontSize="13"/>
                                                        </Button>
                                                        <Rectangle Width="1" Height="14"
                                                                   Fill="{DynamicResource CardDivider}"
                                                                   Margin="3,0" VerticalAlignment="Center"/>
                                                        <Button Style="{StaticResource CardBtn}"
                                                                Command="{Binding InstallCommand}"
                                                                IsEnabled="{Binding CanInstall}"
                                                                ToolTip="Install">
                                                            <TextBlock Text="⬇" FontSize="11"/>
                                                        </Button>
                                                        <Button Style="{StaticResource CardBtn}"
                                                                Command="{Binding UninstallCommand}"
                                                                IsEnabled="{Binding CanUninstall}"
                                                                ToolTip="Uninstall">
                                                            <TextBlock Text="✕" FontSize="10"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Error panel -->
                                                <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                                                        Background="{DynamicResource ErrorPanelBg}"
                                                        BorderBrush="{DynamicResource ErrorPanelBorder}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="14,8,14,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="⚠"
                                                                   Foreground="{DynamicResource ErrorIconFg}"
                                                                   FontSize="12" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding ErrorMessage}"
                                                                   Foreground="{DynamicResource ErrorTextFg}"
                                                                   FontSize="11" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource HeaderBorder}"
                BorderThickness="0,1,0,0"
                Padding="20,7">
            <Grid>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource TextMuted}" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding LastUpdateTime, StringFormat='Updated: {0}'}"
                           Foreground="{DynamicResource TextMuted}" FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>

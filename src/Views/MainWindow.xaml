<Window x:Class="AppPilot.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AppPilot.ViewModels"
        mc:Ignorable="d"
        Title="AppPilot"
        Height="660"
        Width="960"
        MinHeight="480"
        MinWidth="720"
        Background="{DynamicResource WindowBg}"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico">

    <Window.InputBindings>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding FocusSearchCommand}"/>
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseAppCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Scrollbar thumb -->
        <Style x:Key="ScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{DynamicResource ScrollThumb}" CornerRadius="3" Margin="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollPageBtn" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageBtn}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageBtn}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar button -->
        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Background"     Value="{DynamicResource BtnBg}"/>
            <Setter Property="Foreground"     Value="{DynamicResource BtnFg}"/>
            <Setter Property="BorderBrush"    Value="{DynamicResource BtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"        Value="14,7"/>
            <Setter Property="Margin"         Value="0,0,8,0"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"  Value="{DynamicResource BtnHoverBg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BtnHoverBorder}"/>
                                <Setter Property="Foreground"  Value="{DynamicResource BtnHoverFg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BtnPressedBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Background"  Value="{DynamicResource AccentBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
            <Setter Property="Foreground"  Value="{DynamicResource AccentFg}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Background"  Value="{DynamicResource DangerBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
            <Setter Property="Foreground"  Value="{DynamicResource DangerFg}"/>
        </Style>

        <!-- Card icon button (medium size) -->
        <Style x:Key="CardBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource CardBtnFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="36"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardBtnHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource CardBtnHoverFg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardBtnPressedBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab navigation button -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,14"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsKeyboardFocused}" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource TabActiveBorder}"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Geometry x:Key="IconServices">
M2,3H22V17H2V3ZM8,21H16M12,17V21
</Geometry>
        <Geometry x:Key="IconGit">
M12,18A3,3 0 1,0 12,12A3,3 0 0,0 12,18ZM6,6A3,3 0 1,0 6,0A3,3 0 0,0 6,6ZM18,6A3,3 0 1,0 18,0A3,3 0 0,0 18,6ZM18,9V11C18,11.6 17.6,12 17,12H7C6.4,12 6,11.6 6,11V9M12,15V9
</Geometry>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource HeaderBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <!-- Branding -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6366F1" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Path Data="{StaticResource IconLightning}" 
                                  Fill="White"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AppPilot"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Local Service Manager"
                                   FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Search bar + Global action buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,0,0">
                    <!-- Search Bar -->
                    <Border Background="{DynamicResource InputBg}"
                            BorderBrush="{DynamicResource InputBorder}"
                            BorderThickness="1" CornerRadius="8"
                            Height="32" Margin="0,0,18,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="10,0,2,0" IsHitTestVisible="False">
                                <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource TextMuted}" Width="13" Height="13" Stretch="Uniform"/>
                            </TextBlock>
                            <TextBox x:Name="SearchTextBox"
                                     Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource TextPrimary}"
                                     Padding="4,8,10,8" FontSize="13"
                                     VerticalAlignment="Center"
                                     Width="220">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Tag" Value="Search services..."/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                                                <Setter Property="Tag" Value="Search repositories..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Grid>
                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                            <TextBlock IsHitTestVisible="False"
                                                       Text="{TemplateBinding Tag}"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       FontSize="13"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource ToolbarBtn}"
                            Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}"
                                  Fill="Gray"
                                  Width="14" Height="14"
                                  Margin="0,0,6,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentBtn}"
                            Command="{Binding StartAllCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlay}"
                                  Fill="{DynamicResource AccentFg}"
                                  Width="10" Height="10"
                                  Margin="0,0,6,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Start All" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerBtn}"
                            Command="{Binding StopAllCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconStop}"
                                  Fill="{DynamicResource DangerFg}"
                                  Width="10" Height="10"
                                  Margin="0,0,6,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Stop All" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Separator -->
                    <Rectangle Width="1" Height="20"
                               Fill="{DynamicResource HeaderBorder}"
                               Margin="4,0,12,0"
                               VerticalAlignment="Center"/>
                    <!-- Add Service -->
                    <Button Style="{StaticResource AccentBtn}"
                            Command="{Binding AddServiceCommand}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}"
                                  Fill="{DynamicResource AccentFg}"
                                  Width="14" Height="14"
                                  Margin="0,0,5,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Add Service" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Separator -->
                    <Rectangle Width="1" Height="20"
                               Fill="{DynamicResource HeaderBorder}"
                               Margin="4,0,12,0"
                               VerticalAlignment="Center"/>
                    <!-- Theme toggle -->
                    <Button Style="{StaticResource ToolbarBtn}" Margin="0"
                            Command="{Binding ToggleThemeCommand}">
                        <Path Width="20" Height="20"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Fill="Gray">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource IconDark}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLightTheme}" Value="False">
                                            <Setter Property="Data" Value="{StaticResource IconLight}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ Tab Navigation (Row 1) ══════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource TabNavBg}"
                BorderBrush="{DynamicResource HeaderBorder}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="14,0">

                <!-- Services tab -->
                <Border BorderThickness="0,0,0,3" Padding="2,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="0">
                                    <Setter Property="BorderBrush" Value="{DynamicResource TabActiveBorder}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Button Style="{StaticResource TabBtn}" Command="{Binding SelectServicesTabCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconServices}"
                                  Fill="{DynamicResource TabInactiveFg}"
                                  Width="16" Height="16"
                                  Margin="0,0,10,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="0">
                                                <Setter Property="Fill" Value="{DynamicResource TabActiveFg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock FontSize="15" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"       Value="Services"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TabInactiveFg}"/>
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="0">
                                                <Setter Property="Foreground" Value="{DynamicResource TabActiveFg}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Margin="7,0,0,0" Padding="6,2" CornerRadius="10"
                                    Background="{DynamicResource TypeBadgeBg}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Services.Count}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TypeBadgeFg}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Git Repos tab -->
                <Border BorderThickness="0,0,0,3" Padding="2,0" Margin="6,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                                    <Setter Property="BorderBrush" Value="{DynamicResource TabActiveBorder}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Button Style="{StaticResource TabBtn}" Command="{Binding SelectGitTabCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconGit}"
                                  Fill="{DynamicResource TabInactiveFg}"
                                  Width="16" Height="16"
                                  Margin="0,0,10,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                                                <Setter Property="Fill" Value="{DynamicResource TabActiveFg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock FontSize="15" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"       Value="Git Repos"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TabInactiveFg}"/>
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                                                <Setter Property="Foreground" Value="{DynamicResource TabActiveFg}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Margin="7,0,0,0" Padding="6,2" CornerRadius="10"
                                    Background="{DynamicResource TypeBadgeBg}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GitRepositories.Count}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TypeBadgeFg}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </Border>
            </StackPanel>
        </Border>

        <!-- ══════════ Git Repos tab (Row 2) ══════════ -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,12,10,12">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel>
                <!-- Header with Add button -->
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="Git Repositories"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource AccentBtn}"
                            Command="{Binding AddGitRepositoryCommand}"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}"
                                  Fill="{DynamicResource AccentFg}"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0"/>
                            <TextBlock Text="Add Repository" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Empty state -->
                <Border Padding="40,60">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredGitRepositories.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconGit}"
                              Fill="{DynamicResource TextMuted}"
                              Width="48" Height="48"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,12"/>
                        <TextBlock Text="No Git repositories configured"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Click the button above to add a repository"
                                   FontSize="12" Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Repo cards -->
                <ItemsControl ItemsSource="{Binding FilteredGitRepositories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                <StackPanel>

                                    <!-- ── Repo header row ── -->
                                    <Grid Margin="16,14,14,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Repo info -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="5"
                                                        Background="{DynamicResource TypeBadgeBg}"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⎇" FontSize="10" Margin="0,0,4,0"
                                                                   Foreground="{DynamicResource TextMuted}"/>
                                                        <TextBlock Text="{Binding CurrentBranch}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextMuted}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LocalPath}"
                                                       FontSize="10.5" FontFamily="Consolas"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                                       Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding LastCommit}"/>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LastCommit}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Action buttons + status -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       Margin="0,0,12,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                        <Setter Property="Visibility"  Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LastOperationFailed}" Value="True">
                                                                <Setter Property="Visibility"  Value="Visible"/>
                                                                <Setter Property="Foreground"  Value="{DynamicResource StatusErrorColor}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Style="{StaticResource CardBtn}"
                                                    Width="32" Height="32"
                                                    Command="{Binding EditCommand}"
                                                    ToolTip="Edit repository">
                                                <Path Data="{StaticResource IconPencil}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="14" Height="14"
                                                      Stretch="Uniform"/>
                                            </Button>
                                            <Button Style="{StaticResource CardBtn}"
                                                    Width="32" Height="32"
                                                    Command="{Binding DeleteCommand}"
                                                    ToolTip="Delete repository"
                                                    Margin="4,0,8,0">
                                                <Path Data="{StaticResource IconDelete}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="14" Height="14"
                                                      Stretch="Uniform"/>
                                            </Button>
                                            <Button Style="{StaticResource ToolbarBtn}"
                                                    Padding="10,6" Margin="0,0,8,0"
                                                    Command="{Binding PullCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconDownload}"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Width="12" Height="12"
                                                          Stretch="Uniform"
                                                          Margin="0,0,5,0"/>
                                                    <TextBlock Text="Pull" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource AccentBtn}"
                                                    Padding="10,6" Margin="0,0,8,0"
                                                    Command="{Binding BuildSolutionCommand}"
                                                    Visibility="{Binding HasSolution, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconBuild}"
                                                          Fill="{DynamicResource AccentFg}"
                                                          Width="12" Height="12"
                                                          Stretch="Uniform"
                                                          Margin="0,0,5,0"/>
                                                    <TextBlock Text="Build" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource CardBtn}"
                                                    Command="{Binding ToggleOutputCommand}"
                                                    Visibility="{Binding IsOutputVisible, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Hide output">
                                                <Path Data="{StaticResource IconClose}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="10" Height="10"
                                                      Stretch="Uniform"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- ── Linked services ── -->
                                    <Border BorderBrush="{DynamicResource CardDivider}"
                                            BorderThickness="0,1,0,0"
                                            Padding="16,10,16,12"
                                            Visibility="{Binding HasLinkedServices, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="LINKED SERVICES"
                                                       FontSize="9.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding LinkedServices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Grid.Column="0" Width="7" Height="7"
                                                                     VerticalAlignment="Center" Margin="0,0,8,0">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="{DynamicResource StatusStoppedColor}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                                <Setter Property="Fill" Value="{DynamicResource StatusRunningColor}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                                <Setter Property="Fill" Value="{DynamicResource StatusErrorColor}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding DisplayName}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource TextPrimary}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding StatusText}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextMuted}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0"/>
                                                            <Button Grid.Column="3"
                                                                    Style="{StaticResource CardBtn}"
                                                                    Command="{Binding BuildCommand}"
                                                                    Visibility="{Binding HasCsprojPath, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="Build this project">
                                                                <Path Data="{StaticResource IconBuild}" 
                                                                      Fill="{DynamicResource CardBtnFg}"
                                                                      Width="14" Height="14"
                                                                      Stretch="Uniform"/>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- ── Output panel ── -->
                                    <Border BorderBrush="{DynamicResource CardDivider}"
                                            BorderThickness="0,1,0,0"
                                            Visibility="{Binding IsOutputVisible, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <Grid Margin="16,8,16,6">
                                                <TextBlock Text="OUTPUT"
                                                           FontSize="9.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           VerticalAlignment="Center"/>
                                                <Button HorizontalAlignment="Right"
                                                        Style="{StaticResource CardBtn}"
                                                        Width="24" Height="24"
                                                        Command="{Binding ToggleOutputCommand}"
                                                        ToolTip="Close output">
                                                    <Path Data="{StaticResource IconClose}" 
                                                          Fill="{DynamicResource CardBtnFg}"
                                                          Width="10" Height="10"
                                                          Stretch="Uniform"/>
                                                </Button>
                                            </Grid>
                                            <Border Background="{DynamicResource OutputConsoleBg}"
                                                    Margin="16,0,16,14" CornerRadius="6" Padding="12,10">
                                                <TextBox Text="{Binding Output, Mode=OneWay}"
                                                         IsReadOnly="True"
                                                         Background="Transparent" BorderThickness="0"
                                                         Foreground="{DynamicResource OutputConsoleFg}"
                                                         FontFamily="Consolas" FontSize="11"
                                                         TextWrapping="Wrap" MaxHeight="200"
                                                         VerticalScrollBarVisibility="Auto"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Content: grouped service list (Services tab) -->
        <DockPanel Grid.Row="2" LastChildFill="True">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <!-- Grouped service list -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="16,8,10,8">
            <ItemsControl ItemsSource="{Binding FilteredGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4,0,8">

                            <!-- Group header (hidden when single unnamed group) -->
                            <Border Visibility="{Binding ShowHeader, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource GroupHeaderBg}"
                                    BorderBrush="{DynamicResource GroupHeaderBorder}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="8,8,0,0"
                                    Padding="14,8,10,8"
                                    Margin="0,0,0,4">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Colored accent bar -->
                                        <Border Width="4" Height="16" CornerRadius="2" 
                                                Background="{Binding GroupAccentBrush}"
                                                Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding GroupName}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource GroupHeaderFg}"/>
                                        <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="8"
                                                Background="{Binding GroupBadgeBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Items.Count}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding GroupAccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource AccentBtn}"
                                                Padding="8,4" Margin="0,0,6,0"
                                                Command="{Binding StartGroupCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconPlay}" 
                                                      Fill="{DynamicResource AccentBtnFg}"
                                                      Width="9" Height="9"
                                                      Margin="0,0,4,0"
                                                      Stretch="Uniform"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock Text="Start" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DangerBtn}"
                                                Padding="8,4" Margin="0"
                                                Command="{Binding StopGroupCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconStop}" 
                                                      Fill="{DynamicResource DangerBtnFg}"
                                                      Width="9" Height="9"
                                                      Margin="0,0,4,0"
                                                      Stretch="Uniform"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock Text="Stop" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Service cards -->
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6"
                                                CornerRadius="10"
                                                BorderThickness="1"
                                                ClipToBounds="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"  Value="{DynamicResource CardBg}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBg}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource CardErrorBorder}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <!-- Main row -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="5"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Status accent bar -->
                                                    <Border Grid.Column="0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource StatusStoppedColor}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusRunningColor}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Starting">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusTransientColor}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Stopping">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusTransientColor}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusErrorColor}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                    <!-- Service name + type chip -->
                                                    <StackPanel Grid.Column="1" Margin="14,12,10,12" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimary}"/>
                                                            <!-- Type badge with dynamic color -->
                                                            <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4"
                                                                    Background="{Binding TypeBadgeBrush}"
                                                                    BorderBrush="{Binding TypeBadgeFgBrush}"
                                                                    BorderThickness="1"
                                                                    VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Ellipse Width="6" Height="6" Margin="0,0,4,0" 
                                                                             Fill="{Binding TypeBadgeFgBrush}"/>
                                                                    <TextBlock Text="{Binding TypeName}"
                                                                               FontSize="10" FontWeight="SemiBold"
                                                                               Foreground="{Binding TypeBadgeFgBrush}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Status pill -->
                                                    <Border Grid.Column="2" Margin="0,0,10,0"
                                                            Padding="10,4" CornerRadius="20"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource PillDefaultBg}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                        <Setter Property="Background" Value="{DynamicResource PillRunningBg}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Starting">
                                                                        <Setter Property="Background" Value="{DynamicResource PillTransientBg}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Stopping">
                                                                        <Setter Property="Background" Value="{DynamicResource PillTransientBg}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                        <Setter Property="Background" Value="{DynamicResource PillErrorBg}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="{DynamicResource StatusStoppedColor}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                                <Setter Property="Fill" Value="{DynamicResource StatusRunningColor}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Starting">
                                                                                <Setter Property="Fill" Value="{DynamicResource StatusTransientColor}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Stopping">
                                                                                <Setter Property="Fill" Value="{DynamicResource StatusTransientColor}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                                <Setter Property="Fill" Value="{DynamicResource StatusErrorColor}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource PillDefaultFg}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                                <Setter Property="Foreground" Value="{DynamicResource PillRunningFg}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Starting">
                                                                                <Setter Property="Foreground" Value="{DynamicResource PillTransientFg}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Stopping">
                                                                                <Setter Property="Foreground" Value="{DynamicResource PillTransientFg}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                                <Setter Property="Foreground" Value="{DynamicResource PillErrorFg}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Port -->
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding Port}"
                                                               FontSize="12"
                                                               FontFamily="Consolas"
                                                               Foreground="{DynamicResource PortFg}"
                                                               VerticalAlignment="Center"/>

                                                    <!-- Action buttons (medium icons) -->
                                                    <StackPanel Grid.Column="4"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,8,0">
                                                        <Button Style="{StaticResource CardBtn}"
                                                                Command="{Binding StartCommand}"
                                                                IsEnabled="{Binding CanStart}"
                                                                ToolTip="Start">
                                                            <Path Data="{StaticResource IconPlay}" 
                                                                  Fill="{DynamicResource CardBtnFg}"
                                                                  Width="13" Height="13"
                                                                  Stretch="Uniform"/>
                                                        </Button>
                                                        <Button Style="{StaticResource CardBtn}"
                                                                Command="{Binding StopCommand}"
                                                                IsEnabled="{Binding CanStop}"
                                                                ToolTip="Stop">
                                                            <Path Data="{StaticResource IconStop}" 
                                                                  Fill="{DynamicResource CardBtnFg}"
                                                                  Width="13" Height="13"
                                                                  Stretch="Uniform"/>
                                                        </Button>
                                                        <Button Style="{StaticResource CardBtn}"
                                                                Command="{Binding RestartCommand}"
                                                                IsEnabled="{Binding CanRestart}"
                                                                ToolTip="Restart">
                                                            <Path Data="{StaticResource IconRefresh}" 
                                                                  Fill="{DynamicResource CardBtnFg}"
                                                                  Width="15" Height="15"
                                                                  Stretch="Uniform"/>
                                                        </Button>
                                                        <Rectangle Width="1" Height="16"
                                                                   Fill="{DynamicResource CardDivider}"
                                                                   Margin="3,0" VerticalAlignment="Center"/>
                                                        <Button Style="{StaticResource CardBtn}"
                                                                Command="{Binding InstallCommand}"
                                                                IsEnabled="{Binding CanInstall}"
                                                                ToolTip="Install Windows Service">
                                                            <TextBlock Text="⬇" FontSize="14"/>
                                                        </Button>
                                                        <Button Style="{StaticResource CardBtn}"
                                                                Command="{Binding UninstallCommand}"
                                                                IsEnabled="{Binding CanUninstall}"
                                                                ToolTip="Uninstall Windows Service">
                                                            <Path Data="{StaticResource IconClose}" 
                                                                  Fill="{DynamicResource CardBtnFg}"
                                                                  Width="13" Height="13"
                                                                  Stretch="Uniform"/>
                                                        </Button>
                                                        <Rectangle Width="1" Height="16"
                                                                   Fill="{DynamicResource CardDivider}"
                                                                   Margin="3,0" VerticalAlignment="Center"/>
                                                        <Button Style="{StaticResource CardBtn}"
                                                                Command="{Binding BuildCommand}"
                                                                Visibility="{Binding HasCsprojPath, Converter={StaticResource BoolToVis}}"
                                                                ToolTip="Build (dotnet build)">
                                                            <Path Data="{StaticResource IconBuild}" 
                                                                  Fill="{DynamicResource CardBtnFg}"
                                                                  Width="15" Height="15"
                                                                  Stretch="Uniform"/>
                                                        </Button>
                                                        <Rectangle Width="1" Height="16"
                                                                   Fill="{DynamicResource CardDivider}"
                                                                   Margin="3,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding HasBrowserUrl, Converter={StaticResource BoolToVis}}"/>
                                                        <Button Style="{StaticResource CardBtn}"
                                                                Command="{Binding OpenInBrowserCommand}"
                                                                Visibility="{Binding HasBrowserUrl, Converter={StaticResource BoolToVis}}"
                                                                ToolTip="{Binding BrowserUrl}">
                                                            <Path Data="{StaticResource IconExternalLink}" 
                                                                  Fill="{DynamicResource CardBtnFg}"
                                                                  Width="15" Height="15"
                                                                  Stretch="Uniform"/>
                                                        </Button>
                                                        <Button Style="{StaticResource CardBtn}"
                                                                Command="{Binding OpenDirectoryCommand}"
                                                                Visibility="{Binding HasWorkingDirectory, Converter={StaticResource BoolToVis}}"
                                                                ToolTip="{Binding Config.WorkingDirectory}">
                                                            <Path Data="{StaticResource IconFolder}" 
                                                                  Fill="{DynamicResource CardBtnFg}"
                                                                  Width="15" Height="15"
                                                                  Stretch="Uniform"/>
                                                        </Button>
                                                        <Button Style="{StaticResource CardBtn}"
                                                                Command="{Binding OpenTerminalCommand}"
                                                                Visibility="{Binding HasWorkingDirectory, Converter={StaticResource BoolToVis}}"
                                                                ToolTip="Open Terminal Here">
                                                            <Path Data="{StaticResource IconTerminal}" 
                                                                  Fill="{DynamicResource CardBtnFg}"
                                                                  Width="13" Height="13"
                                                                  Stretch="Uniform"/>
                                                        </Button>
                                                        <Rectangle Width="1" Height="16"
                                                                   Fill="{DynamicResource CardDivider}"
                                                                   Margin="3,0" VerticalAlignment="Center"/>
                                                        <Button Style="{StaticResource CardBtn}"
                                                                Command="{Binding EditCommand}"
                                                                ToolTip="Edit Configuration">
                                                            <Path Data="{StaticResource IconPencil}" 
                                                                  Fill="{DynamicResource CardBtnFg}"
                                                                  Width="14" Height="14"
                                                                  Stretch="Uniform"/>
                                                        </Button>
                                                        <Button Style="{StaticResource CardBtn}"
                                                                Command="{Binding DeleteCommand}"
                                                                ToolTip="Remove Service">
                                                            <Path Data="{StaticResource IconDelete}" 
                                                                  Fill="{DynamicResource CardBtnFg}"
                                                                  Width="14" Height="14"
                                                                  Stretch="Uniform"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Error panel -->
                                                <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                                                        Background="{DynamicResource ErrorPanelBg}"
                                                        BorderBrush="{DynamicResource ErrorPanelBorder}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="14,8,14,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="⚠"
                                                                   Foreground="{DynamicResource ErrorIconFg}"
                                                                   FontSize="12" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding ErrorMessage}"
                                                                   Foreground="{DynamicResource ErrorTextFg}"
                                                                   FontSize="11" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Status bar -->
        <Border Grid.Row="3"
                Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource HeaderBorder}"
                BorderThickness="0,1,0,0"
                Padding="20,7">
            <Grid>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource TextMuted}" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding LastUpdateTime, StringFormat='Updated: {0}'}"
                           Foreground="{DynamicResource TextMuted}" FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="AppPilot.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AppPilot.ViewModels"
        xmlns:conv="clr-namespace:AppPilot.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Settings"
        Width="520"
        Height="720"
        MinWidth="480"
        MinHeight="520"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height, Converter={StaticResource WorkAreaHeightConverter}}"
        Background="{DynamicResource WindowBg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToStringConverter x:Key="BoolToStringConverter"/>

        <Style x:Key="DlgScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{DynamicResource ScrollThumb}" CornerRadius="3" Margin="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DlgScrollPageBtn" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DlgScrollPageBtn}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DlgScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DlgScrollPageBtn}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>

        <Style x:Key="FormLabelSecondary" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="FormBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BtnBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BtnFg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"  Value="{DynamicResource BtnHoverBg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BtnHoverBorder}"/>
                                <Setter Property="Foreground"  Value="{DynamicResource BtnHoverFg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BtnPressedBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource FormBtn}">
            <Setter Property="Background"  Value="{DynamicResource AccentBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
            <Setter Property="Foreground"  Value="{DynamicResource AccentFg}"/>
        </Style>

        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TabActiveBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainInput" TargetType="TextBox">
            <Setter Property="Background"    Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground"    Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush"   Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"       Value="10,8"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="CaretBrush"    Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NumberInput" TargetType="TextBox" BasedOn="{StaticResource PlainInput}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ToggleBorder"
                                    Grid.Column="0"
                                    Width="44" Height="24"
                                    CornerRadius="12"
                                    Background="{DynamicResource BtnBg}"
                                    BorderBrush="{DynamicResource BtnBorder}"
                                    BorderThickness="1"
                                    Cursor="Hand">
                                <Grid>
                                    <Ellipse x:Name="ToggleKnob"
                                             Width="18" Height="18"
                                             Fill="{DynamicResource TextMuted}"
                                             HorizontalAlignment="Left"
                                             Margin="3,0,0,0">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="KnobTransform" X="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Margin="10,0,0,0"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource AccentBg}"/>
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
                                <Setter TargetName="ToggleKnob" Property="Fill" Value="{DynamicResource AccentFg}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeToggle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ThemeBorder"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20,16"
                                Cursor="Hand"
                                MinWidth="90">
                            <StackPanel HorizontalAlignment="Center">
                                <Path x:Name="ThemeIcon"
                                      Width="32" Height="32"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,10"
                                      Stretch="Uniform"
                                      Fill="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="ThemeLabel"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Light">
                                <Setter TargetName="ThemeIcon" Property="Data" Value="{StaticResource IconLight}"/>
                                <Setter TargetName="ThemeLabel" Property="Text" Value="Light"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Dark">
                                <Setter TargetName="ThemeIcon" Property="Data" Value="{StaticResource IconDark}"/>
                                <Setter TargetName="ThemeLabel" Property="Text" Value="Dark"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ThemeBorder" Property="Background" Value="{DynamicResource AccentBg}"/>
                                <Setter TargetName="ThemeBorder" Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
                                <Setter TargetName="ThemeLabel" Property="Foreground" Value="{DynamicResource AccentFg}"/>
                                <Setter TargetName="ThemeIcon" Property="Fill" Value="{DynamicResource AccentFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource HeaderBorder}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,16,0"
                        Background="{DynamicResource DialogIconGradient}">
                    <Path Data="{StaticResource IconSettings}"
                          Fill="{DynamicResource DialogIconFill}"
                          Width="20" Height="20"
                          Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Settings"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Configure application preferences"
                               FontSize="11" Foreground="{DynamicResource TextMuted}"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>
                <!-- General Section -->
                <TextBlock Text="GENERAL" Style="{StaticResource SectionHeader}"/>

                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Polling Interval -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Refresh Interval" Style="{StaticResource FormLabel}"/>
                                <TextBlock Text="How often to check service status (in seconds)"
                                           Style="{StaticResource FormLabelSecondary}"/>
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Text="{Binding PollingIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumberInput}"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Theme Section -->
                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}"/>

                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Select Theme" Style="{StaticResource FormLabel}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Tag="Light"
                                         GroupName="Theme"
                                         IsChecked="{Binding Theme, Converter={StaticResource BoolToStringConverter}, ConverterParameter=Light}"
                                         Style="{StaticResource ThemeToggle}"
                                         ToolTip="Switch to Light theme"
                                         Margin="0,0,12,0"/>
                            <RadioButton Tag="Dark"
                                         GroupName="Theme"
                                         IsChecked="{Binding Theme, Converter={StaticResource BoolToStringConverter}, ConverterParameter=Dark}"
                                         Style="{StaticResource ThemeToggle}"
                                         ToolTip="Switch to Dark theme"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- About Section -->
                <TextBlock Text="ABOUT" Style="{StaticResource SectionHeader}"/>

                <Border Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <!-- App Info -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="AppPilot" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding Version, StringFormat='Version {0}'}"
                                           FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="10"
                                    Background="{DynamicResource BrandGradient}" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconLightning}"
                                      Fill="{DynamicResource DialogIconFill}"
                                      Width="18" Height="18"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,0,0,16"/>

                        <!-- Author -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Author" Style="{StaticResource FormLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Author}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- GitHub -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="GitHub" Style="{StaticResource FormLabel}"/>
                            <Button Grid.Column="1"
                                    Content="{Binding GithubUrl}"
                                    Style="{StaticResource LinkBtn}"
                                    Command="{Binding OpenGitHubCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource HeaderBorder}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Reset to Defaults"
                        Style="{StaticResource FormBtn}"
                        Command="{Binding ResetToDefaultsCommand}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Cancel"
                            Style="{StaticResource FormBtn}"
                            Padding="18,8" Margin="0,0,10,0"
                            Click="OnCancel"/>
                    <Button Style="{StaticResource SaveBtn}"
                            Command="{Binding SaveCommand}"
                            Click="OnSave">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCheck}"
                                  Fill="{DynamicResource AccentFg}"
                                  Width="12" Height="12"
                                  Margin="0,0,7,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Save Changes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
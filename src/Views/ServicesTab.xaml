<UserControl x:Class="AppPilot.Views.ServicesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AppPilot.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <!-- Grouped service list -->
    <DockPanel LastChildFill="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,8,10,8">
            <ItemsControl ItemsSource="{Binding FilteredGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4,0,8">

                            <!-- Group header (hidden when single unnamed group) -->
                            <Border Visibility="{Binding ShowHeader, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource GroupHeaderBg}"
                                    BorderBrush="{DynamicResource GroupHeaderBorder}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="8,8,0,0"
                                    Padding="8,8,10,8"
                                    Margin="0,0,0,4">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Colored accent bar -->
                                        <Border Width="10" Height="10" CornerRadius="2" 
                                                Background="{Binding GroupAccentBrush}"
                                                Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding GroupName}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource GroupHeaderFg}"/>
                                        <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="8"
                                                Background="{Binding GroupBadgeBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Items.Count}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding GroupAccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource AccentBtn}"
                                                Padding="8,4" Margin="0,0,6,0"
                                                Command="{Binding StartGroupCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconPlay}"
                                                      Fill="{DynamicResource AccentFg}"
                                                      Width="12" Height="12"
                                                      Margin="0,0,4,0"
                                                      Stretch="Uniform"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock Text="Start" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DangerBtn}"
                                                Padding="8,4" Margin="0"
                                                Command="{Binding StopGroupCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconStop}"
                                                      Fill="{DynamicResource DangerFg}"
                                                      Width="12" Height="12"
                                                      Margin="0,0,4,0"
                                                      Stretch="Uniform"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock Text="Stop" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Service cards -->
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6"
                                                CornerRadius="10"
                                                BorderThickness="1"
                                                ClipToBounds="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"  Value="{DynamicResource CardBg}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBg}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource CardErrorBorder}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <!-- Main row -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="5"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Status accent bar -->
                                                    <Border Grid.Column="0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource StatusStoppedColor}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusRunningColor}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Starting">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusTransientColor}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Stopping">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusTransientColor}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusErrorColor}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                    <!-- Service name + type chip -->
                                                    <StackPanel Grid.Column="1" Margin="14,12,10,12" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimary}"/>
                                                            <!-- Type badge with dynamic color -->
                                                            <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4"
                                                                    Background="{Binding TypeBadgeBrush}"
                                                                    BorderBrush="{Binding TypeBadgeFgBrush}"
                                                                    BorderThickness="1"
                                                                    VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Ellipse Width="6" Height="6" Margin="0,0,4,0" 
                                                                             Fill="{Binding TypeBadgeFgBrush}"/>
                                                                    <TextBlock Text="{Binding TypeName}"
                                                                               FontSize="10" FontWeight="SemiBold"
                                                                               Foreground="{Binding TypeBadgeFgBrush}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Status pill -->
                                                    <Border Grid.Column="2" Margin="0,0,10,0"
                                                            Padding="10,4" CornerRadius="20"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource PillDefaultBg}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                        <Setter Property="Background" Value="{DynamicResource PillRunningBg}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Starting">
                                                                        <Setter Property="Background" Value="{DynamicResource PillTransientBg}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Stopping">
                                                                        <Setter Property="Background" Value="{DynamicResource PillTransientBg}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                        <Setter Property="Background" Value="{DynamicResource PillErrorBg}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="{DynamicResource StatusStoppedColor}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                                <Setter Property="Fill" Value="{DynamicResource StatusRunningColor}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Starting">
                                                                                <Setter Property="Fill" Value="{DynamicResource StatusTransientColor}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Stopping">
                                                                                <Setter Property="Fill" Value="{DynamicResource StatusTransientColor}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                                <Setter Property="Fill" Value="{DynamicResource StatusErrorColor}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource PillDefaultFg}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                                <Setter Property="Foreground" Value="{DynamicResource PillRunningFg}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Starting">
                                                                                <Setter Property="Foreground" Value="{DynamicResource PillTransientFg}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Stopping">
                                                                                <Setter Property="Foreground" Value="{DynamicResource PillTransientFg}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                                <Setter Property="Foreground" Value="{DynamicResource PillErrorFg}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Port -->
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding Port}"
                                                               FontSize="12"
                                                               FontFamily="Consolas"
                                                               Foreground="{DynamicResource PortFg}"
                                                               VerticalAlignment="Center"/>

                                                    <!-- Action buttons (medium icons) -->
                                                    <StackPanel Grid.Column="4"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,8,0">
                                                        <Button Style="{StaticResource CardBtn}"
                                                                Command="{Binding StartCommand}"
                                                                IsEnabled="{Binding CanStart}"
                                                                ToolTip="Start">
                                                            <Path Data="{StaticResource IconPlay}" 
                                                                  Fill="{DynamicResource CardBtnFg}"
                                                                  Width="13" Height="13"
                                                                  Stretch="Uniform"/>
                                                        </Button>
                                                        <Button Style="{StaticResource CardBtn}"
                                                                Command="{Binding StopCommand}"
                                                                IsEnabled="{Binding CanStop}"
                                                                ToolTip="Stop">
                                                            <Path Data="{StaticResource IconStop}" 
                                                                  Fill="{DynamicResource CardBtnFg}"
                                                                  Width="13" Height="13"
                                                                  Stretch="Uniform"/>
                                                        </Button>
                                                        <Button Style="{StaticResource CardBtn}"
                                                                Command="{Binding RestartCommand}"
                                                                IsEnabled="{Binding CanRestart}"
                                                                ToolTip="Restart">
                                                            <Path Data="{StaticResource IconRefresh}" 
                                                                  Fill="{DynamicResource CardBtnFg}"
                                                                  Width="15" Height="15"
                                                                  Stretch="Uniform"/>
                                                        </Button>
                                                        <Rectangle Width="1" Height="16"
                                                                   Fill="{DynamicResource CardDivider}"
                                                                   Margin="3,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding HasBrowserUrl, Converter={StaticResource BoolToVis}}"/>
                                                        <Button Style="{StaticResource CardBtn}"
                                                                Command="{Binding OpenInBrowserCommand}"
                                                                Visibility="{Binding HasBrowserUrl, Converter={StaticResource BoolToVis}}"
                                                                ToolTip="{Binding BrowserUrl}">
                                                            <Path Data="{StaticResource IconExternalLink}" 
                                                                  Fill="{DynamicResource CardBtnFg}"
                                                                  Width="15" Height="15"
                                                                  Stretch="Uniform"/>
                                                        </Button>
                                                        <!-- 3 dots menu -->
                                                        <Button x:Name="MenuButton" 
                                                                Style="{StaticResource CardBtn}"
                                                                ToolTip="More Options"
                                                                Click="MenuButton_Click">
                                                            <Path Data="M144,192a16,16,0,1,1-16-16A16.01833,16.01833,0,0,1,144,192ZM128,80a16,16,0,1,0-16-16A16.01833,16.01833,0,0,0,128,80Zm0,32a16,16,0,1,0,16,16A16.01833,16.01833,0,0,0,128,112Z"
                                                                  Fill="{DynamicResource CardBtnFg}"
                                                                  Width="15" Height="15"
                                                                  Stretch="Uniform"/>
                                                            <Button.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Command="{Binding InstallCommand}"
                                                                              Visibility="{Binding IsWorkerService, Converter={StaticResource BoolToVis}}"
                                                                              IsEnabled="{Binding CanInstall}"
                                                                              ToolTip="Install Windows Service">
                                                                        <MenuItem.Header>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="⬇" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                                <TextBlock Text="Install" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </MenuItem.Header>
                                                                    </MenuItem>
                                                                    <MenuItem Command="{Binding UninstallCommand}"
                                                                              Visibility="{Binding IsWorkerService, Converter={StaticResource BoolToVis}}"
                                                                              IsEnabled="{Binding CanUninstall}"
                                                                              ToolTip="Uninstall Windows Service">
                                                                        <MenuItem.Header>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Path Data="{StaticResource IconClose}" 
                                                                                      Fill="{DynamicResource CardBtnFg}"
                                                                                      Width="12" Height="12"
                                                                                      Stretch="Uniform"
                                                                                      Margin="0,0,8,0"
                                                                                      VerticalAlignment="Center"/>
                                                                                <TextBlock Text="Uninstall" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </MenuItem.Header>
                                                                    </MenuItem>
                                                                    <Separator/>
                                                                    <MenuItem Command="{Binding OpenDirectoryCommand}"
                                                                              Visibility="{Binding HasWorkingDirectory, Converter={StaticResource BoolToVis}}"
                                                                              ToolTip="{Binding Config.WorkingDirectory}">
                                                                        <MenuItem.Header>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Path Data="{StaticResource IconFolder}" 
                                                                                      Fill="{DynamicResource CardBtnFg}"
                                                                                      Width="13" Height="13"
                                                                                      Stretch="Uniform"
                                                                                      Margin="0,0,8,0"
                                                                                      VerticalAlignment="Center"/>
                                                                                <TextBlock Text="Open Folder" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </MenuItem.Header>
                                                                    </MenuItem>
                                                                    <MenuItem Command="{Binding OpenTerminalCommand}"
                                                                              Visibility="{Binding HasWorkingDirectory, Converter={StaticResource BoolToVis}}"
                                                                              ToolTip="Open Terminal Here">
                                                                        <MenuItem.Header>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Path Data="{StaticResource IconTerminal}" 
                                                                                      Fill="{DynamicResource CardBtnFg}"
                                                                                      Width="13" Height="13"
                                                                                      Stretch="Uniform"
                                                                                      Margin="0,0,8,0"
                                                                                      VerticalAlignment="Center"/>
                                                                                <TextBlock Text="Open Terminal" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </MenuItem.Header>
                                                                    </MenuItem>
                                                                    <Separator Visibility="{Binding HasCsprojPath, Converter={StaticResource BoolToVis}}"/>
                                                                    <MenuItem Command="{Binding BuildCommand}"
                                                                              Visibility="{Binding HasCsprojPath, Converter={StaticResource BoolToVis}}"
                                                                              ToolTip="Build (dotnet build)">
                                                                        <MenuItem.Header>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Path Data="{StaticResource IconBuild}" 
                                                                                      Fill="{DynamicResource CardBtnFg}"
                                                                                      Width="13" Height="13"
                                                                                      Stretch="Uniform"
                                                                                      Margin="0,0,8,0"
                                                                                      VerticalAlignment="Center"/>
                                                                                <TextBlock Text="Build" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </MenuItem.Header>
                                                                    </MenuItem>
                                                                    <Separator/>
                                                                    <MenuItem Command="{Binding EditCommand}"
                                                                              ToolTip="Edit Configuration">
                                                                        <MenuItem.Header>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Path Data="{StaticResource IconPencil}" 
                                                                                      Fill="{DynamicResource CardBtnFg}"
                                                                                      Width="13" Height="13"
                                                                                      Stretch="Uniform"
                                                                                      Margin="0,0,8,0"
                                                                                      VerticalAlignment="Center"/>
                                                                                <TextBlock Text="Edit" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </MenuItem.Header>
                                                                    </MenuItem>
                                                                    <MenuItem Command="{Binding DeleteCommand}"
                                                                              ToolTip="Remove Service">
                                                                        <MenuItem.Header>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Path Data="{StaticResource IconDelete}" 
                                                                                      Fill="{DynamicResource CardBtnFg}"
                                                                                      Width="13" Height="13"
                                                                                      Stretch="Uniform"
                                                                                      Margin="0,0,8,0"
                                                                                      VerticalAlignment="Center"/>
                                                                                <TextBlock Text="Delete" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </MenuItem.Header>
                                                                    </MenuItem>
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Error panel -->
                                                <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                                                        Background="{DynamicResource ErrorPanelBg}"
                                                        BorderBrush="{DynamicResource ErrorPanelBorder}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="14,8,14,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="⚠"
                                                                   Foreground="{DynamicResource ErrorIconFg}"
                                                                   FontSize="12" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding ErrorMessage}"
                                                                   Foreground="{DynamicResource ErrorTextFg}"
                                                                   FontSize="11" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>

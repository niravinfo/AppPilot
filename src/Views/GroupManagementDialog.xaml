<Window x:Class="AppPilot.Views.GroupManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AppPilot.ViewModels"
        xmlns:conv="clr-namespace:AppPilot.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:GroupManagementViewModel}"
        Title="Manage Groups"
        Width="780"
        Height="560"
        MinWidth="600"
        MinHeight="400"
        Background="{DynamicResource WindowBg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="DlgScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{DynamicResource ScrollThumb}" CornerRadius="3" Margin="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DlgScrollPageBtn" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DlgScrollPageBtn}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DlgScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DlgScrollPageBtn}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="Bold"/>
        </Style>

        <Style x:Key="FormBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BtnBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BtnFg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"  Value="{DynamicResource BtnHoverBg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BtnHoverBorder}"/>
                                <Setter Property="Foreground"  Value="{DynamicResource BtnHoverFg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BtnPressedBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource FormBtn}">
            <Setter Property="Background"  Value="{DynamicResource AccentBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
            <Setter Property="Foreground"  Value="{DynamicResource AccentFg}"/>
            <Setter Property="Padding"     Value="20,8"/>
        </Style>

        <Style x:Key="RemoveBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="26"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource DangerBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DangerFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainInput" TargetType="TextBox">
            <Setter Property="Background"    Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground"    Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush"   Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"       Value="8,6"/>
            <Setter Property="FontSize"      Value="11"/>
            <Setter Property="CaretBrush"    Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatch" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="28"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Swatch"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Swatch" Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaletteColorBtn" TargetType="Button">
            <Setter Property="Width"           Value="22"/>
            <Setter Property="Height"          Value="22"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="Transparent"/>
                            </Border.BorderBrush>
                            <Border.BorderThickness>
                                <Thickness>2</Thickness>
                            </Border.BorderThickness>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClearBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="4,2"/>
            <Setter Property="FontSize"        Value="9"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BtnHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding AddGroupCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Color Picker Popup -->
        <Popup x:Name="ColorPickerPopup"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=ColorPickerPlacementTarget}"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Width="180">
            <Border Background="{DynamicResource HeaderBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.25" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Preset Colors"
                               FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,0,0,6"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PaletteColorBtn}" Background="#6366F1" Margin="2" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteColorBtn}" Background="#8B5CF6" Margin="2" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteColorBtn}" Background="#EC4899" Margin="2" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteColorBtn}" Background="#EF4444" Margin="2" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteColorBtn}" Background="#F59E0B" Margin="2" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteColorBtn}" Background="#10B981" Margin="2" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteColorBtn}" Background="#06B6D4" Margin="2" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteColorBtn}" Background="#3B82F6" Margin="2" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteColorBtn}" Background="#14B8A6" Margin="2" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteColorBtn}" Background="#84CC16" Margin="2" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteColorBtn}" Background="#F97316" Margin="2" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteColorBtn}" Background="#A855F7" Margin="2" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteColorBtn}" Background="#E11D48" Margin="2" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteColorBtn}" Background="#0EA5E9" Margin="2" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteColorBtn}" Background="#64748B" Margin="2" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteColorBtn}" Background="#1E293B" Margin="2" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteColorBtn}" Background="#FFFFFF" Margin="2" Click="PaletteColor_Click"/>
                        <Button Style="{StaticResource PaletteColorBtn}" Background="#000000" Margin="2" Click="PaletteColor_Click"/>
                    </WrapPanel>
                    <Button Style="{StaticResource ClearBtn}"
                            Content="Clear color"
                            HorizontalAlignment="Right"
                            Margin="0,6,0,0"
                            Click="ClearColor_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Invisible placement target for the popup -->
        <FrameworkElement x:Name="ColorPickerPlacementTarget" Width="0" Height="0" Visibility="Hidden"/>

        <!-- ═══ Header ═══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource HeaderBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#8B5CF6" Offset="0"/>
                            <GradientStop Color="#EC4899" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Path Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z"
                          Fill="White"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Manage Groups"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Organize services into groups with custom names and colors"
                               FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ Main Content ═══ -->
        <DockPanel Grid.Row="1" LastChildFill="True" Margin="16,12">

            <!-- Add group bar -->
            <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentBtn}"
                        Command="{Binding AddGroupCommand}"
                        Padding="14,8" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Add Group" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource PlainInput}"
                         Height="34"
                         KeyDown="NewGroupTextBox_KeyDown">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Padding="{TemplateBinding Padding}"
                                                  Focusable="False"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden"/>
                                </Border>
                                <TextBlock IsHitTestVisible="False"
                                           Text="Enter new group name..."
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="11"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
            </DockPanel>

            <!-- Status message -->
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                       FontSize="10.5" Foreground="{DynamicResource AccentFg}"
                       Margin="0,6,0,0"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Groups list -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Table header -->
                    <Border Background="{DynamicResource SectionBg}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,7"
                            Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="NAME" Style="{StaticResource SectionTitle}" Margin="4,0,0,0"/>
                            <TextBlock Grid.Column="1" Text="COLOR" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="ORDER" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="SERVICES" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Group rows -->
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBg}"
                                        BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,7"
                                        Margin="0,0,0,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBg}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Name input -->
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource PlainInput}"
                                                 Height="28"
                                                 FontSize="11"
                                                 FontWeight="SemiBold"
                                                 Margin="4,0"
                                                 Padding="6,3"/>

                                        <!-- Color picker + hex input -->
                                        <Grid Grid.Column="1" Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Color swatch button -->
                                            <Button Grid.Column="0" Style="{StaticResource ColorSwatch}"
                                                    Click="ColorSwatch_Click"
                                                    Tag="{Binding}"
                                                    ToolTip="Pick color"
                                                    Margin="0,0,4,0">
                                                <Button.Background>
                                                    <Binding Path="ColorCode">
                                                        <Binding.Converter>
                                                            <conv:HexToBrushConverter/>
                                                        </Binding.Converter>
                                                    </Binding>
                                                </Button.Background>
                                            </Button>

                                            <!-- Hex input -->
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding ColorCode, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource PlainInput}"
                                                     Height="28"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     FontSize="10"
                                                     Padding="6,3"
                                                     HorizontalContentAlignment="Center">
                                                <TextBox.Template>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Grid>
                                                            <Border x:Name="Bd"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="5">
                                                                <ScrollViewer x:Name="PART_ContentHost"
                                                                              Padding="{TemplateBinding Padding}"
                                                                              Focusable="False"
                                                                              HorizontalScrollBarVisibility="Hidden"
                                                                              VerticalScrollBarVisibility="Hidden"/>
                                                            </Border>
                                                            <TextBlock IsHitTestVisible="False"
                                                                       Text="#AABBCC"
                                                                       Foreground="{DynamicResource TextMuted}"
                                                                       FontSize="10"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsFocused" Value="True">
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </TextBox.Template>
                                            </TextBox>
                                        </Grid>

                                        <!-- Order input -->
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding DisplayOrder, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource PlainInput}"
                                                 Height="28"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 FontSize="10"
                                                 Margin="4,0"
                                                 Padding="6,3"
                                                 HorizontalContentAlignment="Center"/>

                                        <!-- Service count -->
                                        <TextBlock Grid.Column="3" Text="{Binding ServiceCount}"
                                                   FontSize="11" Foreground="{DynamicResource TextMuted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- Remove -->
                                        <Button Grid.Column="4" Style="{StaticResource RemoveBtn}"
                                                Command="{Binding DataContext.RemoveGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Remove group"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconClose}"
                                                  Fill="{DynamicResource TextMuted}"
                                                  Width="10" Height="10"
                                                  Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <TextBlock Text="No groups configured. Add a group above to organize your services."
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="11" FontStyle="Italic"
                               HorizontalAlignment="Center"
                               Margin="0,24,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Groups.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ═══ Footer ═══ -->
        <Border Grid.Row="2"
                Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource HeaderBorder}"
                BorderThickness="0,1,0,0"
                Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource FormBtn}"
                        Padding="16,8" Margin="0,0,10,0"
                        Click="OnCancel"/>
                <Button Style="{StaticResource SaveBtn}"
                        Click="OnSave">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCheck}"
                              Fill="{DynamicResource BtnFg}"
                              Width="12" Height="12"
                              Margin="0,0,7,0"
                              Stretch="Uniform"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Save All Changes" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>

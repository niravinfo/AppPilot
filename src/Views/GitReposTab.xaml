<UserControl x:Class="AppPilot.Views.GitReposTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AppPilot.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="16,12,10,12">
        <StackPanel>
            <!-- Header with Add button -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="Git Repositories"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource AccentBtn}"
                        Command="{Binding AddGitRepositoryCommand}"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}"
                              Fill="{DynamicResource AccentFg}"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Margin="0,0,6,0"/>
                        <TextBlock Text="Add Repository" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Empty state -->
            <Border Padding="40,60">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredGitRepositories.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconGit}"
                          Fill="{DynamicResource TextMuted}"
                          Width="48" Height="48"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,12"/>
                    <TextBlock Text="No Git repositories configured"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Click the button above to add a repository"
                               FontSize="12" Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Repo cards -->
            <ItemsControl ItemsSource="{Binding FilteredGitRepositories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                            <StackPanel>

                                <!-- ── Repo header row ── -->
                                <Grid Margin="16,14,14,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Repo info -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                            <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="5"
                                                    Background="{DynamicResource TypeBadgeBg}"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⎇" FontSize="10" Margin="0,0,4,0"
                                                               Foreground="{DynamicResource TextMuted}"/>
                                                    <TextBlock Text="{Binding CurrentBranch}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextMuted}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding LocalPath}"
                                                   FontSize="10.5" FontFamily="Consolas"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                                   Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding LastCommit}"/>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LastCommit}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Action buttons + status -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Margin="0,0,12,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                    <Setter Property="Visibility"  Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LastOperationFailed}" Value="True">
                                                            <Setter Property="Visibility"  Value="Visible"/>
                                                            <Setter Property="Foreground"  Value="{DynamicResource StatusErrorColor}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Style="{StaticResource CardBtn}"
                                                Width="32" Height="32"
                                                Command="{Binding EditCommand}"
                                                ToolTip="Edit repository">
                                            <Path Data="{StaticResource IconPencil}"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Width="14" Height="14"
                                                  Stretch="Uniform"/>
                                        </Button>
                                        <Button Style="{StaticResource CardBtn}"
                                                Width="32" Height="32"
                                                Command="{Binding DeleteCommand}"
                                                ToolTip="Delete repository"
                                                Margin="4,0,8,0">
                                            <Path Data="{StaticResource IconDelete}"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Width="14" Height="14"
                                                  Stretch="Uniform"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarBtn}"
                                                Padding="10,6" Margin="0,0,8,0"
                                                Command="{Binding PullCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconDownload}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="12" Height="12"
                                                      Stretch="Uniform"
                                                      Margin="0,0,5,0"/>
                                                <TextBlock Text="Pull" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource AccentBtn}"
                                                Padding="10,6" Margin="0,0,8,0"
                                                Command="{Binding BuildSolutionCommand}"
                                                Visibility="{Binding HasSolution, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconBuild}"
                                                      Fill="{DynamicResource AccentFg}"
                                                      Width="12" Height="12"
                                                      Stretch="Uniform"
                                                      Margin="0,0,5,0"/>
                                                <TextBlock Text="Build" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource CardBtn}"
                                                Command="{Binding ToggleOutputCommand}"
                                                Visibility="{Binding IsOutputVisible, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Hide output">
                                            <Path Data="{StaticResource IconClose}"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Width="10" Height="10"
                                                  Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- ── Linked services ── -->
                                <Border BorderBrush="{DynamicResource CardDivider}"
                                        BorderThickness="0,1,0,0"
                                        Padding="16,10,16,12"
                                        Visibility="{Binding HasLinkedServices, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="LINKED SERVICES"
                                                   FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding LinkedServices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Grid.Column="0" Width="7" Height="7"
                                                                 VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource StatusStoppedColor}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                            <Setter Property="Fill" Value="{DynamicResource StatusRunningColor}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                            <Setter Property="Fill" Value="{DynamicResource StatusErrorColor}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DisplayName}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding StatusText}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                                        <Button Grid.Column="3"
                                                                Style="{StaticResource CardBtn}"
                                                                Command="{Binding BuildCommand}"
                                                                Visibility="{Binding HasCsprojPath, Converter={StaticResource BoolToVis}}"
                                                                ToolTip="Build this project">
                                                            <Path Data="{StaticResource IconBuild}" 
                                                                  Fill="{DynamicResource CardBtnFg}"
                                                                  Width="14" Height="14"
                                                                  Stretch="Uniform"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- ── Output panel ── -->
                                <Border BorderBrush="{DynamicResource CardDivider}"
                                        BorderThickness="0,1,0,0"
                                        Visibility="{Binding IsOutputVisible, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Grid Margin="16,8,16,6">
                                            <TextBlock Text="OUTPUT"
                                                       FontSize="9.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       VerticalAlignment="Center"/>
                                            <Button HorizontalAlignment="Right"
                                                    Style="{StaticResource CardBtn}"
                                                    Width="24" Height="24"
                                                    Command="{Binding ToggleOutputCommand}"
                                                    ToolTip="Close output">
                                                <Path Data="{StaticResource IconClose}" 
                                                      Fill="{DynamicResource CardBtnFg}"
                                                      Width="10" Height="10"
                                                      Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                        <Border Background="{DynamicResource OutputConsoleBg}"
                                                Margin="16,0,16,14" CornerRadius="6" Padding="12,10">
                                            <TextBox Text="{Binding Output, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{DynamicResource OutputConsoleFg}"
                                                     FontFamily="Consolas" FontSize="11"
                                                     TextWrapping="Wrap" MaxHeight="200"
                                                     VerticalScrollBarVisibility="Auto"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<Window x:Class="AppPilot.Views.ServiceEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AppPilot.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ServiceEditorViewModel}"
        Title="{Binding Title}"
        Width="680"
        SizeToContent="Height"
        MaxHeight="860"
        Background="{DynamicResource WindowBg}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Scrollbar thumb -->
        <Style x:Key="DlgScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{DynamicResource ScrollThumb}" CornerRadius="3" Margin="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DlgScrollPageBtn" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DlgScrollPageBtn}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DlgScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DlgScrollPageBtn}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section title -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Margin"      Value="0,0,0,10"/>
        </Style>

        <!-- Field label -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,4"/>
        </Style>

        <!-- Field hint -->
        <Style x:Key="FormHint" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="Margin"      Value="0,3,0,0"/>
        </Style>

        <!-- Text input -->
        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Background"    Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground"    Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush"   Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"       Value="10,8"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="CaretBrush"    Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Foreground"    Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="Height"        Value="36"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding"    Value="10,7"/>
                        <Setter Property="FontSize"   Value="12"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnHoverBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BtnHoverFg}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <Border x:Name="Bd"
                                    Background="{DynamicResource InputBg}"
                                    BorderBrush="{DynamicResource InputBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid Margin="10,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                    <TextBlock Grid.Column="1" Text="▾"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource InputBg}"
                                        BorderBrush="{DynamicResource InputBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, ElementName=Root}"
                                        Margin="0,2,0,0">
                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button -->
        <Style x:Key="FormBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BtnBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource BtnFg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"  Value="{DynamicResource BtnHoverBg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BtnHoverBorder}"/>
                                <Setter Property="Foreground"  Value="{DynamicResource BtnHoverFg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BtnPressedBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent save button -->
        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource FormBtn}">
            <Setter Property="Background"  Value="{DynamicResource AccentBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
            <Setter Property="Foreground"  Value="{DynamicResource AccentFg}"/>
            <Setter Property="Padding"     Value="20,8"/>
        </Style>

        <!-- Inline remove button for env var rows -->
        <Style x:Key="EnvRemoveBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="26"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource DangerBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DangerFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox style -->
        <Style x:Key="FormCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBorder"
                                    Width="18" Height="18"
                                    CornerRadius="4"
                                    BorderThickness="1.5"
                                    Background="{DynamicResource InputBg}"
                                    BorderBrush="{DynamicResource InputBorder}"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                      Fill="{DynamicResource AccentFg}"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Opacity="0"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
                                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AccentBg}"/>
                                <Setter TargetName="CheckMark" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource HeaderBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0"
                        Background="{DynamicResource DialogIconGradient}">
                    <Path Data="{StaticResource IconSettings}" 
                          Fill="{DynamicResource DialogIconFill}"
                          Width="18" Height="18"
                          Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                               Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Configure service settings"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWorkerType}" Value="True">
                                        <Setter Property="Text" Value="Configure worker service settings"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsApiOrGrpcType}" Value="True">
                                        <Setter Property="Text" Value="Configure API / gRPC service settings"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsNodeAppType}" Value="True">
                                        <Setter Property="Text" Value="Configure Node.js / React application"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ Scrollable form content ═══ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="680">
            <StackPanel Margin="24,18,24,8">

                <!-- ── IDENTITY ── -->
                <TextBlock Text="IDENTITY" Style="{StaticResource SectionTitle}"/>

                <!-- Display Name + Internal Name -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Display Name" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}"
                                 ToolTip="User-friendly name shown in the UI"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Internal Name" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="11"
                                 ToolTip="Unique identifier for the service"/>
                    </StackPanel>
                </Grid>

                <!-- Group + Type -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Group" Style="{StaticResource FormLabel}"/>
                        <ComboBox ItemsSource="{Binding Groups}"
                                  SelectedValue="{Binding GroupId, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource FormCombo}"
                                  ToolTip="Service group for organization"/>
                        <!-- New group inline -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="NewGroupTextBox_KeyDown"
                                         Height="28"
                                         Background="{DynamicResource InputBg}"
                                         Foreground="{DynamicResource TextPrimary}"
                                         BorderBrush="{DynamicResource InputBorder}"
                                         BorderThickness="1"
                                         FontSize="10"
                                         CaretBrush="{DynamicResource TextPrimary}"
                                         VerticalContentAlignment="Center"
                                         Padding="8,0">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBlock Text="New group name..."
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="10"
                                           Margin="11,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NewGroupName}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NewGroupName}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="2" Style="{StaticResource FormBtn}"
                                    Command="{Binding AddNewGroupCommand}"
                                    ToolTip="Create new group"
                                    Height="28" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Add" FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Type" Style="{StaticResource FormLabel}"/>
                        <ComboBox ItemsSource="{Binding ServiceTypes}"
                                  SelectedItem="{Binding ServiceType}"
                                  Style="{StaticResource FormCombo}"/>
                    </StackPanel>
                </Grid>

                <!-- Display Order -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Display Order" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding DisplayOrder, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,7">
                        <TextBlock Text="Lower numbers appear first in the list" Style="{StaticResource FormHint}"/>
                    </StackPanel>
                </Grid>

                <!-- Divider -->
                <Rectangle Height="1" Fill="{DynamicResource CardDivider}" Margin="0,0,0,16"/>

                <!-- ── PROCESS (.NET services only) ── -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNodeAppType}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                <TextBlock Text="PROCESS" Style="{StaticResource SectionTitle}"/>

                <!-- Executable Path -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Executable Path" Style="{StaticResource FormLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="11"
                                 ToolTip="Path to the compiled .exe file"/>
                        <Button Grid.Column="2" Style="{StaticResource FormBtn}"
                                Command="{Binding BrowseExecutablePathCommand}"
                                Padding="10,8" ToolTip="Browse for executable">
                            <Path Data="{StaticResource IconFolder}" 
                                  Fill="{DynamicResource BtnFg}"
                                  Width="13" Height="13"
                                  Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Csproj Path -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Project File" Style="{StaticResource FormLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding CsprojPath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="11"
                                 ToolTip="Path to .csproj or .slnx file for building"/>
                        <Button Grid.Column="2" Style="{StaticResource FormBtn}"
                                Command="{Binding BrowseCsprojPathCommand}"
                                Padding="10,8" ToolTip="Browse for project file">
                            <Path Data="{StaticResource IconFolder}" 
                                  Fill="{DynamicResource BtnFg}"
                                  Width="13" Height="13"
                                  Stretch="Uniform"/>
                        </Button>
                    </Grid>
                    <TextBlock Text="Required for the Build command to work" Style="{StaticResource FormHint}"/>
                </StackPanel>

                <!-- Arguments -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Arguments" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormInput}"
                             FontFamily="{StaticResource MonoFont}" FontSize="11"
                             ToolTip="Command-line arguments passed to the executable"/>
                </StackPanel>

                <!-- Working Directory -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Working Directory" Style="{StaticResource FormLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="11"
                                 ToolTip="Working directory for the process"/>
                        <Button Grid.Column="2" Style="{StaticResource FormBtn}"
                                Command="{Binding BrowseWorkingDirectoryCommand}"
                                Padding="10,8" ToolTip="Browse for folder">
                            <Path Data="{StaticResource IconFolder}" 
                                  Fill="{DynamicResource BtnFg}"
                                  Width="13" Height="13"
                                  Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Divider (.NET services) -->
                <Rectangle Height="1" Fill="{DynamicResource CardDivider}" Margin="0,0,0,16"/>
                </StackPanel>

                <!-- ── NODE.JS PROJECT (NodeApp only) ── -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNodeAppType}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="NODE.JS PROJECT" Style="{StaticResource SectionTitle}"/>

                    <!-- Project Path -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Project Folder" Style="{StaticResource FormLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormInput}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="11"
                                     ToolTip="Path to the Node.js project folder containing package.json"/>
                            <Button Grid.Column="2" Style="{StaticResource FormBtn}"
                                    Command="{Binding BrowseProjectPathCommand}"
                                    Padding="10,8" ToolTip="Browse for project folder">
                                <Path Data="{StaticResource IconFolder}" 
                                      Fill="{DynamicResource BtnFg}"
                                      Width="13" Height="13"
                                      Stretch="Uniform"/>
                            </Button>
                        </Grid>
                        <TextBlock Text="Folder containing package.json where npm commands will run" Style="{StaticResource FormHint}"/>
                    </StackPanel>

                    <Rectangle Height="1" Fill="{DynamicResource CardDivider}" Margin="0,0,0,16"/>

                    <!-- npm Commands -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="NPM COMMANDS"
                                   Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center" Margin="0"/>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource FormBtn}"
                                    Command="{Binding AddDefaultNpmCommandsCommand}"
                                    Padding="10,5" Margin="0,0,6,0"
                                    ToolTip="Add default npm commands (build, start, serve, preview)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⟳" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Defaults" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FormBtn}"
                                    Command="{Binding AddNpmCommandCommand}"
                                    Padding="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Add Command" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource SectionBg}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,0,0,4">
                        <StackPanel>
                            <!-- Column headers -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="NAME"
                                           Style="{StaticResource SectionTitle}"
                                           Margin="4,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="COMMAND"
                                           Style="{StaticResource SectionTitle}"
                                           Margin="4,0,0,0"/>
                            </Grid>

                            <!-- Command rows -->
                            <ItemsControl ItemsSource="{Binding NpmCommands}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormInput}"
                                                     FontSize="11"
                                                     ToolTip="Command name (first letter shown on button)"/>
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormInput}"
                                                     FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                     ToolTip="npm command to execute (e.g., npm run build)"/>
                                            <Button Grid.Column="3"
                                                    Style="{StaticResource EnvRemoveBtn}"
                                                    Command="{Binding DataContext.RemoveNpmCommandCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Remove command">
                                                <Path Data="{StaticResource IconClose}" 
                                                      Fill="{DynamicResource CardBtnFg}"
                                                      Width="10" Height="10"
                                                      Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty state -->
                            <TextBlock Text="No npm commands configured. Click 'Defaults' to add common commands."
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="11" FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NpmCommands.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Button shows first letter of name. Full name appears on hover." 
                               Style="{StaticResource FormHint}" Margin="0,4,0,0"/>

                    <Rectangle Height="1" Fill="{DynamicResource CardDivider}" Margin="0,16,0,16"/>
                </StackPanel>

                <!-- ── CONNECTION (API / gRPC only) ── -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsApiOrGrpcType}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="CONNECTION" Style="{StaticResource SectionTitle}"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Port" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormInput}"
                                     ToolTip="Port number the service listens on"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Health Check URL" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding HealthCheckUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormInput}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="11"
                                     ToolTip="URL used to check service health (e.g. /health)"/>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource CardDivider}" Margin="0,0,0,16"/>
                </StackPanel>

                <!-- ── INSTALLATION (Worker only) ── -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWorkerType}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="INSTALLATION" Style="{StaticResource SectionTitle}"/>

                    <CheckBox Content="Install as Windows Service"
                              IsChecked="{Binding UseWindowsService}"
                              Style="{StaticResource FormCheck}"
                              Margin="0,0,0,16"
                              ToolTip="When enabled, the worker will be installed and managed as a Windows Service"/>

                    <Rectangle Height="1" Fill="{DynamicResource CardDivider}" Margin="0,0,0,16"/>
                </StackPanel>

                <!-- ── ENVIRONMENT VARIABLES ── -->
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="ENVIRONMENT VARIABLES"
                               Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center" Margin="0"/>
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource FormBtn}"
                            Command="{Binding AddEnvironmentVariableCommand}"
                            Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Add Variable" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Background="{DynamicResource SectionBg}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8"
                        Margin="0,0,0,4">
                    <StackPanel>
                        <!-- Column headers -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="KEY"
                                       Style="{StaticResource SectionTitle}"
                                       Margin="4,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="VALUE"
                                       Style="{StaticResource SectionTitle}"
                                       Margin="4,0,0,0"/>
                        </Grid>

                        <!-- Variable rows -->
                        <ItemsControl ItemsSource="{Binding EnvironmentVariables}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormInput}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormInput}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                                        <Button Grid.Column="3"
                                                Style="{StaticResource EnvRemoveBtn}"
                                                Command="{Binding DataContext.RemoveEnvironmentVariableCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Remove variable">
                                            <Path Data="{StaticResource IconClose}" 
                                                  Fill="{DynamicResource CardBtnFg}"
                                                  Width="10" Height="10"
                                                  Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <TextBlock Text="No environment variables configured."
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="11" FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EnvironmentVariables.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Rectangle Height="12"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ Footer ═══ -->
        <Border Grid.Row="2"
                Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource HeaderBorder}"
                BorderThickness="0,1,0,0"
                Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource FormBtn}"
                        Padding="16,8" Margin="0,0,10,0"
                        Click="OnCancel"/>
                <Button Style="{StaticResource SaveBtn}"
                        Click="OnSave">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCheck}" 
                              Fill="{DynamicResource BtnFg}"
                              Width="12" Height="12"
                              Margin="0,0,7,0"
                              Stretch="Uniform"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SaveButtonText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
